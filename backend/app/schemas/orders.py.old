"""
Feat4-SR1
The system shall allow users to create food orders

This file defines the request and response structure for order creation
and retrieval in the API layer.
"""

from pydantic import BaseModel
from typing import List


# One item inside an order request/response
class OrderItem(BaseModel):
    menuItemId: int
    quantity: int


# Request body for creating an order
class OrderCreateRequest(BaseModel):
    restaurant_id: int
    items: List[OrderItem]


# Response returned after creating/retrieving an order
class OrderOut(BaseModel):
    orderId: int
    restaurant_id: int
    items: List[OrderItem]